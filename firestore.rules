
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Fungsi pembantu untuk memverifikasi autentikasi pengguna
    function isAuthenticated() {
      return request.auth != null;
    }

    // Aturan default: akses penuh jika terautentikasi (Administrator)
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
    
    // Aturan spesifik untuk koleksi applicants
    match /applicants/{applicantId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // Aturan spesifik untuk pengaturan sistem
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Aturan spesifik untuk data akademik dan penilaian
    // Komentar pemicu redeploy: Menambahkan izin eksplisit untuk modul penilaian guru dan manajemen kurikulum
    match /staff/{staffId} {
      allow read, write: if isAuthenticated();
    }

    match /classes/{classId} {
      allow read, write: if isAuthenticated();
    }

    match /subjects/{subjectId} {
      allow read, write: if isAuthenticated();
    }

    match /teacherAssignments/{assignmentId} {
      allow read, write: if isAuthenticated();
    }

    match /assessments/{assessmentId} {
      allow read, write: if isAuthenticated();
    }
  }
}
