
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ATURAN KEAMANAN SEDERHANA & KUAT - SIS TERPADU
    
    // Izin untuk seluruh koleksi akademik bagi pengguna terautentikasi
    match /journals/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    match /assessments/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    match /classes/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    match /staff/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    match /subjects/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    match /teacherAssignments/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Pendaftar (Read publik untuk cek status)
    match /applicants/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Pengaturan Sistem
    match /settings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Fallback
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
