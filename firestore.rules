
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Hanya izinkan baca/tulis jika pengguna sudah terautentikasi (Admin)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Khusus pendaftar mungkin butuh akses baca publik jika ada fitur cek status mandiri nantinya
    match /applicants/{applicantId} {
      allow read: if true; // Izinkan publik baca untuk cek status
      allow write: if request.auth != null; // Hanya admin bisa tulis
    }
    
    match /settings/{settingId} {
      allow read: if true; // Izinkan publik baca nama sekolah dll
      allow write: if request.auth != null;
    }
  }
}
