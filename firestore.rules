
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Sinkronisasi Izin Terpusat - Update Terakhir: 2024-05-21 23:59 (CRITICAL FIX)
    // Memastikan akses penuh untuk staf/guru yang terautentikasi.
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. Aturan Koleksi Jurnal (Penting untuk Guru)
    match /journals/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // 2. Aturan Koleksi Penilaian & Nilai
    match /assessments/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // 3. Aturan Koleksi Manajemen Akademik
    match /classes/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /staff/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /subjects/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /teacherAssignments/{document=**} {
      allow read, write: if isAuthenticated();
    }
    
    // 4. Aturan Spesifik Pendaftar (Read publik untuk status, Write harus login)
    match /applicants/{applicantId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // 5. Aturan Pengaturan Sistem (Read publik untuk branding)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 6. Aturan Default (Fallback)
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
