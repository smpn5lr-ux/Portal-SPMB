
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Terakhir diperbarui: 2024-05-20 (Force update untuk koleksi journals & assessments)
    
    // Fungsi pembantu untuk memverifikasi autentikasi pengguna
    function isAuthenticated() {
      return request.auth != null;
    }

    // Aturan default: akses penuh jika terautentikasi (Administrator/Staf/Guru)
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
    
    // Aturan spesifik untuk koleksi applicants (Read publik untuk cek status, Write harus login)
    match /applicants/{applicantId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // Aturan spesifik untuk pengaturan sistem (Read publik untuk branding aplikasi)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Aturan eksplisit untuk koleksi penilaian dan akademik guna mencegah error 'list'
    match /assessments/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /journals/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /teacherAssignments/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /classes/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /staff/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /subjects/{docId} {
      allow read, write: if isAuthenticated();
    }
  }
}
