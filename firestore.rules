
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // SINKRONISASI KEAMANAN TERPUSAT - SIS TERPADU (Update: 2024-05-22 01:00)
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. Aturan Koleksi Jurnal & Absensi (Kritikal: Memisahkan root list dan document read)
    match /journals {
      allow read, write: if isAuthenticated();
    }
    match /journals/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // 2. Aturan Koleksi Penilaian & Nilai
    match /assessments {
      allow read, write: if isAuthenticated();
    }
    match /assessments/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // 3. Aturan Koleksi Manajemen Akademik
    match /classes {
      allow read, write: if isAuthenticated();
    }
    match /classes/{document=**} {
      allow read, write: if isAuthenticated();
    }

    match /staff {
      allow read, write: if isAuthenticated();
    }
    match /staff/{document=**} {
      allow read, write: if isAuthenticated();
    }

    match /subjects {
      allow read, write: if isAuthenticated();
    }
    match /subjects/{document=**} {
      allow read, write: if isAuthenticated();
    }

    match /teacherAssignments {
      allow read, write: if isAuthenticated();
    }
    match /teacherAssignments/{document=**} {
      allow read, write: if isAuthenticated();
    }
    
    // 4. Aturan Spesifik Pendaftar (Read publik untuk cek status, Write harus login)
    match /applicants/{applicantId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /applicants {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // 5. Aturan Pengaturan Sistem (Read publik untuk branding)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 6. Aturan Default (Fallback)
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
