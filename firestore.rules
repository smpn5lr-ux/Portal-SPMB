
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Fungsi pembantu untuk memverifikasi autentikasi pengguna
    function isAuthenticated() {
      return request.auth != null;
    }

    // Aturan default: akses penuh jika terautentikasi (Administrator)
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
    
    // Aturan spesifik untuk koleksi applicants
    // Komentar pemicu redeploy: Menyinkronkan status verifikasi dan kelulusan pendaftar
    match /applicants/{applicantId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // Aturan spesifik untuk pengaturan sistem
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Aturan spesifik untuk data pegawai
    match /staff/{staffId} {
      allow read, write: if isAuthenticated();
    }
  }
}
