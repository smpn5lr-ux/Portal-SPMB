
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Sinkronisasi Izin Terpusat - Update: 2024-05-21 17:00
    
    // Fungsi pembantu untuk memverifikasi autentikasi pengguna
    function isAuthenticated() {
      return request.auth != null;
    }

    // Aturan eksplisit untuk koleksi journals (Mencegah FirestorePermissionError: list)
    match /journals/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // Aturan eksplisit untuk koleksi assessments
    match /assessments/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // Aturan eksplisit untuk koleksi teacherAssignments
    match /teacherAssignments/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // Aturan eksplisit untuk koleksi classes
    match /classes/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // Aturan eksplisit untuk koleksi staff
    match /staff/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // Aturan eksplisit untuk koleksi subjects
    match /subjects/{document=**} {
      allow read, write: if isAuthenticated();
    }
    
    // Aturan spesifik untuk koleksi applicants (Read publik untuk cek status, Write harus login)
    match /applicants/{applicantId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // Aturan spesifik untuk pengaturan sistem (Read publik untuk branding aplikasi)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Aturan default: akses penuh jika terautentikasi (Administrator/Staf/Guru)
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
