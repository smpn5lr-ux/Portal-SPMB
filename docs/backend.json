
{
  "entities": {
    "Applicant": {
      "title": "Applicant",
      "description": "Information about a student applying for admission with complete Dapodik fields.",
      "type": "object",
      "properties": {
        "registrationNumber": { "type": "string" },
        "registrationSequence": { "type": "number" },
        "NISN": { "type": "string" },
        "NIK": { "type": "string" },
        "familyCardNumber": { "type": "string" },
        "aktaLahirNumber": { "type": "string" },
        "fullName": { "type": "string" },
        "birthPlace": { "type": "string" },
        "birthDate": { "type": "string" },
        "gender": { "type": "string", "enum": ["Laki-laki", "Perempuan"] },
        "religion": { "type": "string" },
        "address": { "type": "string" },
        "rt": { "type": "string" },
        "rw": { "type": "string" },
        "kelurahan": { "type": "string" },
        "kecamatan": { "type": "string" },
        "propinsi": { "type": "string" },
        "livingWith": { "type": "string", "enum": ["Bersama Orang Tua", "Wali", "Asrama", "Kos"] },
        "transportation": { "type": "string", "enum": ["Jalan Kaki", "Motor", "Mobil", "Angkot/Kendaraan Umum"] },
        "childOrder": { "type": "number" },
        "studentPhone": { "type": "string" },
        "parentName": { "type": "string" },
        "parentPhone": { "type": "string" },
        "parentEmail": { "type": "string" },
        "originSchool": { "type": "string" },
        "applicationPath": { "type": "string", "enum": ["Zonasi", "Prestasi", "Afirmasi", "Perpindahan Orang Tua"] },
        "verificationStatus": { "type": "string", "enum": ["Belum Diverifikasi", "Lengkap", "Perlu Perbaikan", "Ditolak"] },
        "academicScore": { "type": "number" },
        "distanceToSchoolKm": { "type": "number" },
        "ageYears": { "type": "number" },
        "admissionStatus": { "type": "string", "enum": ["accepted", "waitlisted", "rejected", "pending"] },
        "numberOfSiblings": { "type": "number" },
        "heightCm": { "type": "number" },
        "weightKg": { "type": "number" },
        "travelTimeMinutes": { "type": "number" },
        "welfareType": { "type": "string", "enum": ["PIP", "PKH", "KKS", "KPS", "Tidak Ada"] },
        "welfareCardNumber": { "type": "string" },
        "welfareCardName": { "type": "string" },
        "registrationType": { "type": "string", "enum": ["Murid Baru", "Mutasi", "Mengulang"] },
        "ijazahSerialNumber": { "type": "string" },
        "fatherName": { "type": "string" },
        "fatherNIK": { "type": "string" },
        "fatherBirthYear": { "type": "string" },
        "fatherEducation": { "type": "string" },
        "fatherJob": { "type": "string" },
        "fatherIncome": { "type": "string" },
        "motherName": { "type": "string" },
        "motherNIK": { "type": "string" },
        "motherBirthYear": { "type": "string" },
        "motherEducation": { "type": "string" },
        "motherJob": { "type": "string" },
        "motherIncome": { "type": "string" },
        "guardianName": { "type": "string" },
        "guardianNIK": { "type": "string" },
        "guardianBirthYear": { "type": "string" },
        "guardianEducation": { "type": "string" },
        "guardianJob": { "type": "string" },
        "guardianIncome": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "isDeleted": { "type": "boolean" },
        "deletedAt": { "type": "string" }
      },
      "required": ["NISN", "fullName", "applicationPath"]
    },
    "Classroom": {
      "title": "Classroom",
      "description": "Information about a class group (rombongan belajar).",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "gradeLevel": { "type": "number" },
        "homeroomTeacher": { "type": "string" },
        "capacity": { "type": "number" },
        "currentEnrollment": { "type": "number" },
        "students": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Staff": {
      "title": "Staff",
      "description": "Information about school staff or employees.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["Admin", "Pegawai", "Guru"] },
        "phone": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fullName", "email", "role"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Educational subjects taught in school.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "code": { "type": "string" },
        "grade": { "type": "number" }
      },
      "required": ["name"]
    },
    "TeacherAssignment": {
      "title": "TeacherAssignment",
      "description": "Mapping of which teacher teaches which subject in which class.",
      "type": "object",
      "properties": {
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "classId": { "type": "string" },
        "className": { "type": "string" },
        "subjectId": { "type": "string" },
        "subjectName": { "type": "string" }
      }
    },
    "Journal": {
      "title": "Journal",
      "description": "Teaching journals and attendance for each meeting.",
      "type": "object",
      "properties": {
        "assignmentId": { "type": "string" },
        "meetingNumber": { "type": "number" },
        "date": { "type": "string" },
        "material": { "type": "string" },
        "absentStudents": { "type": "array", "items": { "type": "string" } },
        "hasTask": { "type": "boolean" },
        "taskType": { "type": "string" },
        "semester": { "type": "number" }
      }
    },
    "Assessment": {
      "title": "Assessment",
      "description": "Student grades for a specific subject and class per semester.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "assignmentId": { "type": "string" },
        "semester": { "type": "number", "enum": [1, 2] },
        "attendance": { "type": "number" },
        "task1": { "type": "number" },
        "task2": { "type": "number" },
        "task3": { "type": "number" },
        "groupTask": { "type": "number" },
        "midExam": { "type": "number" },
        "finalExam": { "type": "number" },
        "finalScore": { "type": "number" },
        "updatedAt": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/applicants/{applicantId}": {
      "schema": "Applicant",
      "description": "Collection of student applications."
    },
    "/classes/{classId}": {
      "schema": "Classroom",
      "description": "Collection of class groups."
    },
    "/staff/{staffId}": {
      "schema": "Staff",
      "description": "Collection of school staff members."
    },
    "/subjects/{subjectId}": {
      "schema": "Subject",
      "description": "Collection of subjects."
    },
    "/teacherAssignments/{assignmentId}": {
      "schema": "TeacherAssignment",
      "description": "Collection of assignments linking teachers to subjects and classes."
    },
    "/journals/{journalId}": {
      "schema": "Journal",
      "description": "Teaching journals and attendance logs."
    },
    "/assessments/{assessmentId}": {
      "schema": "Assessment",
      "description": "Collection of student grades."
    },
    "/settings/{settingId}": {
      "schema": "object",
      "description": "Global system settings."
    }
  }
}
